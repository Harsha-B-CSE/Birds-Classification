# ==============================================================================
# FEATHERED INSIGHTS - ENVIRONMENT TEMPLATE
# ==============================================================================
# Mode Switch: Set to True for Cloud Firestore sync, or False for purely local offline operation
USE_FIREBASE=False

# Firebase Project Configuration
FIREBASE_CREDENTIALS=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=birds-classification-4511c.appspot.com

# Django Core Settings
DEBUG=True
SECRET_KEY=replace-with-your-production-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# 3-Check Inference Gates (calibrated defaults)
BIRD_PRESENCE_THRESHOLD=0.60
OOD_ENERGY_THRESHOLD=-3.90
OOD_CONFIDENCE_FLOOR=0.40

# Local dossier generation (offline-first)
SPECIES_INFO_MODE=local
SPECIES_EXTERNAL_ENRICHMENT=False
LOCAL_LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_MAX_NEW_TOKENS=220
